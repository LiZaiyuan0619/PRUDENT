+# Added for diagnosis: IFPRUNE_DUMP_PATH=<file.jsonl> appends, per sample, the small
+# model's full visual-token importance (float32, base64) and the tile count, so later
+# analyses (entropy, overlap with a second estimator) need not rerun the small model.
+# The importance does not depend on the keep ratio. Unset = shipped behaviour.
+_DUMP_PATH = os.environ.get("IFPRUNE_DUMP_PATH")
+
+
+def _dump_importance(task, doc_id, num_patches, importance):
+    import base64
+    import json
+
+    arr = importance.detach().float().cpu().numpy().astype(np.float32).reshape(-1)
+    rec = {
+        "task": task,
+        "doc_id": doc_id,
+        "num_patches": int(num_patches),
+        "n_visual": int(arr.size),
+        "importance_f32_b64": base64.b64encode(arr.tobytes()).decode("ascii"),
+    }
+    with open(_DUMP_PATH, "a") as f:
+        f.write(json.dumps(rec) + "\n")
+
+
